# Required. Use a fine-grained PAT restricted to TARGET_REPO with only:
# contents:write, pull-requests:write, and issues:write.
GITHUB_TOKEN=
META_API_KEY=
TARGET_REPO=owner/repository

# Optional operator settings.
# DATA_DIR defaults to ~/.simple-coding-agent/ and CLONE_DIR to $DATA_DIR/repo/.
# DATA_DIR=/path/to/agent-data
# CLONE_DIR=/path/to/persistent-clone
# POLL_INTERVAL=60
# LOG_LEVEL=INFO
# MODEL_TIMEOUT=3600
# PUBLISH_TIMEOUT=120
# MAX_RETRIES=3
# MAX_CONSECUTIVE_ERRORS=3

# Repository profile commands (setup/check) run with a deliberately minimal
# PATH (os.defpath) that excludes the orchestrator's own environment. If a
# profile command needs a tool installed outside that default PATH (e.g. `uv`
# under Homebrew at /opt/homebrew/bin, or ~/.local/bin), list its directories
# here, colon-separated. They are prepended to the command's PATH.
# PROFILE_EXTRA_PATH=/opt/homebrew/bin:/usr/local/bin

# By default the repository profile is read from
# docs/agents/simple-coding-agent-profile.yml inside the target repository.
# Set PROFILE_PATH to load it from elsewhere instead, e.g. alongside this
# agent's own Dockerfile/config.
# PROFILE_PATH=/path/to/simple-coding-agent-profile.yml

# The default false loads user-installed skills/settings only. Setting true also
# loads target-repository project settings. Hooks are disabled, but repository
# apiKeyHelper, settings env entries, and project-skill allowed-tools remain an
# accepted residual exposure. Enable it only for repositories you trust.
# AGENT_TRUST_PROJECT_SETTINGS=false

# By default, must-fix review findings block publication. An explicitly empty
# value selects the agreed test-only review gate.
# REVIEW_BLOCKING_SEVERITIES=must-fix

# Provider-side spending caps are the source of truth. MAX_BUDGET_USD=5 is an
# SDK circuit breaker, not authoritative Meta billing. MAX_TURNS bounds turns
# per attempt. Before either hard limit, the agent asks the model to hand off
# its progress cooperatively: SOFT_THRESHOLD_PERCENTAGE (0-1, exclusive) sets
# how far below MAX_BUDGET_USD that cost soft threshold sits
# (soft = max_budget_usd - max_budget_usd * percentage). Turns/MODEL_TIMEOUT
# have no soft threshold; reaching either gets one best-effort handoff
# follow-up instead. See docs/agents/operator-onboarding.md.
# MAX_TURNS=60
# MAX_BUDGET_USD=5
# SOFT_THRESHOLD_PERCENTAGE=0.2
#
# MODEL_NAME pins the Meta model with no fallback. CLAUDE_AGENT_SDK_VERSION and
# CLAUDE_CODE_VERSION pin the runtime that provenance verification checks
# against at startup; bump them here after validating an upgrade.
# MODEL_NAME=muse-spark-1.3-contributor
# CLAUDE_AGENT_SDK_VERSION=0.2.163
# CLAUDE_CODE_VERSION=2.1.286

# Model backend settings. Defaults reproduce the current Meta behaviour, so an
# existing .env with only META_API_KEY keeps working with no edits.
# MODEL_BASE_URL=https://api.meta.ai
# MODEL_AUTH_MODE=auth_token
# MODEL_API_KEY falls back to META_API_KEY when unset; when both are set,
# MODEL_API_KEY wins. One of the two must be set.
# MODEL_API_KEY=
# MODEL_STREAM_IDLE_TIMEOUT_MS=60000

# Meta through the LiteLLM gateway (restores prompt caching, see #169 and
# docs/adr/0003-litellm-gateway-for-meta-prompt-caching.md). The gateway is
# separate infrastructure; start the agent with the network overlay:
#   docker compose -f docker-compose.yml -f docker-compose.litellm.yml up -d
# MODEL_API_KEY is the gateway's LITELLM_MASTER_KEY. META_API_KEY then lives
# only in the gateway's configuration: remove it from this file.
# MODEL_BASE_URL=http://litellm:4000
# MODEL_API_KEY=<LITELLM_MASTER_KEY>
# MODEL_AUTH_MODE=auth_token and MODEL_NAME stay at their defaults.
# Name of the external Docker network shared with the gateway (overlay only):
# LITELLM_NETWORK=main

# Alternative backend for testing (Anthropic API directly):
# MODEL_BASE_URL=
# MODEL_AUTH_MODE=api_key
# MODEL_API_KEY=sk-ant-...
# MODEL_NAME=claude-sonnet-5-5
